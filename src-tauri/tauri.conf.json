{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lawyer Calendar",
  "version": "2.0.0",
  "identifier": "th.lawfirm.lawyercalendar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../.next"
  },
  "app": {
    "windows": [
      {
        "title": "Lawyer Calendar | ระบบปฏิทินนัดหมายสำนักงานทนายความ",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"]
  }
}
